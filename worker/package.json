    "docxtemplater": "^3.50.0",
    "pizzip": "^3.1.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241112.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.88.0"
  }
}
